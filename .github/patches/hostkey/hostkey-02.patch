+type HostKeyProblemKind = 'unknown' | 'changed' | 'fingerprintMismatch' | 'storage'
+
+interface HostKeyProblem {
+  kind: HostKeyProblemKind
+  host: string
+  port: number
+  algorithm: string
+  fingerprint: string
+  knownHostsPath: string
+  line?: number
+  details?: string
+}
+
+const HOST_KEY_ERROR_PREFIX = 'OHMYPANEL_HOST_KEY:'
+
+function parseHostKeyProblem(error: unknown): HostKeyProblem | null {
+  const raw = error instanceof Error ? error.message : String(error)
+  const prefixIndex = raw.indexOf(HOST_KEY_ERROR_PREFIX)
+  if (prefixIndex < 0) return null
+
+  const payload = raw.slice(prefixIndex + HOST_KEY_ERROR_PREFIX.length).trim()
+  const candidates = [payload]
+  const firstBrace = payload.indexOf('{')
+  const lastBrace = payload.lastIndexOf('}')
+  if (firstBrace >= 0 && lastBrace > firstBrace) {
+    candidates.push(payload.slice(firstBrace, lastBrace + 1))
+  }
+
+  for (const candidate of candidates) {
+    try {
+      const parsed = JSON.parse(candidate) as Partial<HostKeyProblem>
+      if (
+        (parsed.kind === 'unknown' || parsed.kind === 'changed' || parsed.kind === 'fingerprintMismatch' || parsed.kind === 'storage') &&
+        typeof parsed.host === 'string' &&
+        typeof parsed.port === 'number' &&
+        typeof parsed.algorithm === 'string' &&
+        typeof parsed.fingerprint === 'string' &&
+        typeof parsed.knownHostsPath === 'string'
+      ) {
+        return parsed as HostKeyProblem
+      }
+    } catch {
+      // Try the next candidate.
+    }
+  }
+
+  return null
+}
+
+function formatHostKeyProblem(problem: HostKeyProblem): string {
+  const endpoint = `${problem.host}:${problem.port}`
+  if (problem.kind === 'changed') {
+    return `SECURITY WARNING: The SSH host key for ${endpoint} has changed. The connection was blocked to prevent a possible man-in-the-middle attack. Presented key: ${problem.algorithm} ${problem.fingerprint}. Verify the server fingerprint through a trusted channel before changing the stored entry${problem.line ? ` at line ${problem.line}` : ''} in ${problem.knownHostsPath}.`
+  }
+  if (problem.kind === 'fingerprintMismatch') {
+    return `The SSH host key for ${endpoint} changed between confirmation and connection. The connection was blocked. Presented key: ${problem.algorithm} ${problem.fingerprint}.`
+  }
+  if (problem.kind === 'storage') {
+    return `Host-key verification failed for ${endpoint}: ${problem.details || 'the known_hosts file could not be accessed'}. File: ${problem.knownHostsPath}`
+  }
+  return `The SSH host key for ${endpoint} is not trusted. Presented key: ${problem.algorithm} ${problem.fingerprint}. Reconnect manually to review and confirm it.`
+}
