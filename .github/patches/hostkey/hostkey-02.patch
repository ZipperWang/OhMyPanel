diff --git a/src/host-key.css b/src/host-key.css
new file mode 100644
index 0000000..975eb24
--- /dev/null
+++ b/src/host-key.css
@@ -0,0 +1,66 @@
+/* SSH host-key confirmation */
+.host-key-dialog {
+  width: 560px;
+}
+
+.host-key-message {
+  margin-bottom: 14px;
+  text-align: left;
+}
+
+.host-key-details {
+  display: grid;
+  gap: 10px;
+  margin-bottom: 18px;
+  padding: 14px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+  background: var(--bg-subtle);
+}
+
+.host-key-details > div {
+  display: grid;
+  grid-template-columns: 145px minmax(0, 1fr);
+  align-items: start;
+  gap: 12px;
+}
+
+.host-key-details span {
+  color: var(--text-muted);
+  font-size: 13px;
+}
+
+.host-key-details code {
+  overflow-wrap: anywhere;
+  color: var(--text-heading);
+  font-size: 12px;
+  line-height: 1.5;
+  user-select: text;
+}
+
+.host-key-actions {
+  display: grid;
+  grid-template-columns: 1fr 2fr;
+  gap: 10px;
+}
+
+.host-key-cancel-btn {
+  padding: 10px 16px;
+  border: 1px solid var(--border);
+  border-radius: 6px;
+  background: var(--bg-subtle);
+  color: var(--text);
+  font-size: 14px;
+  cursor: pointer;
+}
+
+.host-key-cancel-btn:hover {
+  background: var(--border);
+}
+
+@media (max-width: 640px) {
+  .host-key-details > div,
+  .host-key-actions {
+    grid-template-columns: 1fr;
+  }
+}
