+    let base = dirs::config_dir().unwrap_or_else(|| PathBuf::from("."));
+    let current = base.join("ohmypanel");
+    let legacy = base.join("leepanel");
+    let path = if current.exists() || !legacy.exists() {
+        current
+    } else {
+        legacy
+    };
     std::fs::create_dir_all(&path).ok();
     path
 }
 
-/// Get the SQLite database path: <config_dir>/leepanel/data.db
+/// Get the SQLite database path inside the selected application data directory.
 pub fn db_path() -> PathBuf {
     let mut path = db_dir();
     path.push("data.db");
