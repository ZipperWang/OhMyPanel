-/// Get the SQLite data directory: <config_dir>/leepanel
+/// Get the application data directory.
+///
+/// New installations use `<config_dir>/ohmypanel`. Existing installations
+/// continue using the legacy `<config_dir>/leepanel` directory so saved
+/// connections and credentials are not silently lost during the rename.
 pub fn db_dir() -> PathBuf {
-    let mut path = dirs::config_dir().unwrap_or_else(|| PathBuf::from("."));
